APP_ORIGIN=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Optional alternative: a restricted PostgreSQL login. When set, this takes precedence over Supabase.
# Initialize a fresh database with postgres/schema.sql and grant migsak_app to a separate LOGIN role.
DATABASE_URL=
# Generate a separate random password and session secret; never prefix these NEXT_PUBLIC_.
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
